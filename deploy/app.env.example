# Template for /etc/safelife/app.env on the instance.
#
#   cp deploy/app.env.example deploy/app.env     # your working copy, gitignored
#   ${EDITOR} deploy/app.env                     # fill it in
#   ./tools/deploy.sh --env                      # push it and restart
#
# Never put real values in THIS file - it is tracked, and the repository is public.
# On the host the live file is 0600 root:root.
#
# Two sections. The first is the real service. The second is only what the bundled demo
# container needs, and goes away when the real image replaces it.


# ############################################################################
# THE SERVICE
# ############################################################################
# Standard .NET configuration keys, where __ stands in for the : in a key name.
# Verified end to end: mixed case, __, and values containing ; = . and spaces all pass
# through an env_file into the container unaltered. Nothing needs escaping.

# ---------------------------------------------------------------------------
# Database - ours, and we generate the whole string:
#     cd infra && tofu output -raw connection_string_dotnet
#
# Npgsql cannot parse a postgres:// URI, which is the usual first-run failure. The three
# settings at the end matter: managed Postgres refuses plaintext, its certificate comes
# from the provider's own CA so hostname verification must be off, and the pool cap keeps
# us under the ~20-connection ceiling of the entry-tier plan.
# ---------------------------------------------------------------------------
ConnectionStrings__SafeLife=Host=<host>;Port=<port>;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true;Maximum Pool Size=8

# ---------------------------------------------------------------------------
# Public identity. We supply this, because only the deployment knows it.
#
# Twilio signs the EXACT url it was configured with, and behind Caddy the application only
# sees http://localhost:8080 - so it cannot work this out for itself. Must match the Twilio
# console character for character, scheme included, no trailing slash.
# ---------------------------------------------------------------------------
PublicBaseUrl=https://sos.safelife.ch

# ---------------------------------------------------------------------------
# Twilio - SMS, the backup path when a device's TCP session is dead.
#
# The auth token is not interchangeable with an API key: inbound webhook signatures are
# HMAC-SHA1 keyed on the ACCOUNT AUTH TOKEN specifically. If API keys or a Messaging
# Service are added later, tell us the key names and we will carry them too.
# ---------------------------------------------------------------------------
Twilio__AccountSid=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
Twilio__AuthToken=CHANGE_ME
Twilio__From=+41000000000

# ---------------------------------------------------------------------------
# SendGrid - email. Twilio's email product, authenticating separately with its own key.
# Scope the API key to "Mail Send" only.
#
# Deliverability is not a key in this file: the sending domain needs Domain Authentication
# with a custom return path, and click tracking off for transactional mail. See the runbook.
# ---------------------------------------------------------------------------
SendGrid__ApiKey=
SendGrid__From=alerts@safelife.ch

# ---------------------------------------------------------------------------
# Microsoft Entra External ID - an EXTERNAL tenant, not a workforce tenant.
# (Azure AD B2C closed to new customers on 1 May 2025.)
#
# Note Authority, not Instance + TenantId: external tenants use the ciamlogin host, and
# the workforce shape is the usual first mistake. Verify a value with
#     curl -s '<authority>/v2.0/.well-known/openid-configuration'
# which returns JSON if it is right. It is not a page - a browser will show nothing.
#
# Register exactly these redirect URIs on the app registration:
#     https://sos.safelife.ch/signin-oidc
#     https://sos.safelife.ch/signout-callback-oidc
# ---------------------------------------------------------------------------
AzureAd__Authority=https://<tenant-name>.ciamlogin.com/<tenant-id>
AzureAd__ClientId=
AzureAd__ClientSecret=
AzureAd__CallbackPath=/signin-oidc
AzureAd__SignedOutCallbackPath=/signout-callback-oidc

# ---------------------------------------------------------------------------
Logging__LogLevel__Default=Information


# ############################################################################
# DEMO CONTAINER ONLY - delete this section when the real image lands
# ############################################################################
# The stand-in app predates the naming above and reads flat variables. Both sets can sit
# in the file at once; they do not collide.

PGHOST=safelife-db-exoscale-xxxxxxxx.l.aivencloud.com
PGPORT=21699
PGDATABASE=defaultdb
PGUSER=avnadmin
PGPASSWORD=CHANGE_ME
PGSSLMODE=Require
PGTRUSTSERVERCERT=true
PGMAXPOOL=8

SAFELIFE_TCP_PORT=9770
SAFELIFE_HTTP_PORT=8080
SAFELIFE_IDLE_TIMEOUT_SECONDS=300
SAFELIFE_MAX_CONNECTIONS=2500

PUBLIC_BASE_URL=https://sos.safelife.ch
