# Copy to /etc/safelife/app.env on the instance, fill in, then:
#   sudo chmod 600 /etc/safelife/app.env
#
# This file holds live secrets. deploy/app.env is gitignored; this .example file is
# tracked - never put real values in it.

# ============================================================================
# PostgreSQL   (from: exo dbaas show safelife-db --zone ch-dk-2 --uri)
# ============================================================================
PGHOST=safelife-db-exoscale-xxxxxxxx.b.aivencloud.com
PGPORT=21699
PGDATABASE=defaultdb
PGUSER=avnadmin
PGPASSWORD=CHANGE_ME

# Managed Postgres refuses plaintext; the certificate comes from the provider's own CA.
PGSSLMODE=Require
PGTRUSTSERVERCERT=true

# Keep well under the ~20-connection ceiling of an entry-tier managed instance.
PGMAXPOOL=8

# ============================================================================
# Service ports and limits
# ============================================================================
SAFELIFE_TCP_PORT=9770
SAFELIFE_HTTP_PORT=8080
SAFELIFE_IDLE_TIMEOUT_SECONDS=300
SAFELIFE_MAX_CONNECTIONS=2500

# ============================================================================
# Public identity
# ============================================================================
# The address the outside world reaches us on, scheme included. Required for Twilio
# webhook signature validation: Twilio signs the EXACT url it was configured with, but
# behind Caddy the app sees http://localhost:8080 and would compute a different one.
# Must match the webhook url configured in the Twilio console, character for character.
PUBLIC_BASE_URL=https://safelife.example.ch

# ============================================================================
# Twilio - SMS, as a backup path for device traffic
# ============================================================================
# Auth token is NOT interchangeable with an API key. Signature validation on inbound
# webhooks is HMAC-SHA1 keyed on the ACCOUNT AUTH TOKEN specifically, so it is required
# even when outbound calls use an API key.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=CHANGE_ME

# Preferred for outbound REST calls: API keys can be revoked individually, the account
# auth token cannot be revoked without breaking everything at once. Leave blank to fall
# back to the account sid + auth token pair.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# A Messaging Service handles number pools, sender selection and opt-outs. Prefer it over
# pinning a single number; set TWILIO_FROM_NUMBER only if no messaging service is used.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=+41000000000

# Never set this to false in a deployed environment. Twilio publishes no webhook IP
# ranges - they are deliberately dynamic - so the signature is the only thing standing
# between your webhook and the open internet.
TWILIO_VALIDATE_SIGNATURES=true

# ============================================================================
# Twilio SendGrid - email
# ============================================================================
# Twilio's email product is SendGrid; it authenticates separately from the SMS side with
# its own API key. Scope the key to "Mail Send" only.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@example.ch
SENDGRID_FROM_NAME=SafeLife Central

# ============================================================================
# Anything else the application needs
# ============================================================================
# Declare additional variables here as the developer introduces them - for example the
# rule that decides when SMS takes over from a dead TCP session. The semantics are the
# application's; this file only has to carry them.
# SMS_FALLBACK_AFTER_SECONDS=600

Logging__LogLevel__Default=Information
