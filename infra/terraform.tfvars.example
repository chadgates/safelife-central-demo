# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

# Required. Every address that should reach SSH and the database directly.
# Add the current one with: echo "  \"$(curl -s https://ifconfig.me)/32\","
#
# A caution on dynamic addresses: a /32 you no longer hold may later belong to somebody
# else, so prune entries you stop recognising rather than letting the list grow.
admin_cidrs = [
  "203.0.113.10/32",   # office
  "198.51.100.7/32",   # home
]

zone = "ch-dk-2"

# Cheapest path to start: run Postgres as a container on the instance and skip the
# managed service. Saves CHF 41.84/month; you own backups and it dies with the instance.
#   managed_database = false
#   instance_type    = "standard.medium"   # 4 GiB, so the database has somewhere to live

# Narrow this the moment TWIG give you their source ranges.
# device_source_cidrs = ["198.51.100.0/24"]
